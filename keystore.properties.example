# Facultatif : copie en "keystore.properties" (ignoré par git) pour signer la release avec ta propre clé.
# Sans ce fichier, la release est signée avec la clé debug (suffisant pour un usage perso).
# Création d'une clé :
#   keytool -genkeypair -v -keystore mytv-release.jks -alias mytv -keyalg RSA -keysize 2048 -validity 10000
storeFile=mytv-release.jks
storePassword=
keyAlias=mytv
keyPassword=
