<?xml version="1.0" encoding="utf-8"?>
<!-- Les portails IPTV servent API et flux en HTTP : le clair est autorisé globalement. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
